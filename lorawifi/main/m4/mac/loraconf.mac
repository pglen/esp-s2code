<script async>

    //console.log("Start LORA");

    const isNumeric2 = (str) => Number.isFinite(+str);

    function check_lims(data, validx, lower, upper) {

        valx = data.get(validx)

        if (!isNumeric2(valx))
            {
            alert("Field: " + validx + " must be a number.")
            return 0;
            }
        //console.log("value: %s", valx);
        if (valx < lower || valx > upper)
            {
            alert("Number out of range for:  " + validx + " value = " + valx)
            return 0;
            }
        return 1;
        }
    async function save_lora() {
        //console.log("Save LORA");
        const formData = new FormData(myform);
        //console.log("Data", formData);
        if(!check_lims(formData, "spread", 6, 12)) return;
        if(!check_lims(formData, "bwidth", 10, 500)) return;
        if(!check_lims(formData, "txfreq", 433.05, 434.79)) return;
        if(!check_lims(formData, "deftrench", 0, 65534)) return;

        const plainFormData = Object.fromEntries(formData.entries());
        const jsonString = JSON.stringify(plainFormData);
        //console.log("Submitting: '%s'", jsonString);
        //document.getElementById("myform").submit();
        const response = await fetch("page_3.html", {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: jsonString
                })
        const data = await response.text();
        //console.log("Data from lora config: " + data)
        const confButt = document.getElementById('confbutt');
        //console.log("butt:", confButt)
        confButt.value = data;
    }

    async function default_lora() {
        //console.log("default_lora()");
        const formData = new FormData(myform);
        formData.append("reset", "1");
        const plainFormData = Object.fromEntries(formData.entries());
        const jsonString = JSON.stringify(plainFormData);
        console.log("Submitting: '%s'", jsonString);
        //document.getElementById("myform").submit();
        const response = await fetch("page_3.html", {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: jsonString
                })
        const data = await response.text();
        console.log("Data from lora reset: " + data)
        const defButt = document.getElementById('defbutt');
        defButt.value = data;

        // Fake reset config fields NOTE: change when code in chip changes
        document.getElementById('spread').value = 10;
        document.getElementById('bwidth').value = 50;
        document.getElementById('txpower').value = 12;
        document.getElementById('txfreq').value = 433.375;
    }
</script>

<table width=100%>

    <tr><td colspan=2>
    &nbsp; &nbsp; The following fields determine the LORA transmit / receive configuration.
    These configurations must match between the sender and receiver units.
    The parameters are range contained. The frequency parameter is a floating
    point number multiplied by megahertz. The bandwidth parameter is a floating
    point number multiplied by kilohertz. Please note: for communication
    stability the lowest recommended bandwidth is 40+ kHz. (This is due to the
    LORA Board's chrystal instability)

